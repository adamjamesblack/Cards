{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/buttons/**",
              "components/cards/**",
              "components/email/**",
              "components/feedback/**",
              "components/forms/**",
              "components/icons/**",
              "ui_kits/email/**",
              "ui_kits/member-portal/**",
              "ui_kits/social/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Libre Baskerville|Material Symbols Rounded))/i]",
        "message": "Font not provided by the design system. Available: Inter, Libre Baskerville, Material Symbols Rounded."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|src|size|tone|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: name, src, size, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:purple|light|neutral)$/]",
        "message": "<Avatar> tone must be one of 'purple' | 'light' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:purple|light|cyan|teal|neutral|outline)$/]",
        "message": "<Badge> tone must be one of 'purple' | 'light' | 'cyan' | 'teal' | 'neutral' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|fullWidth|disabled|type|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, fullWidth, disabled, type, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|gradient|padding|radius|shadow|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, tone, gradient, padding, radius, shadow, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmailButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|color|href|style|key|ref|className|style|children)$/]",
        "message": "<EmailButton> doesn't accept that prop. Declared props: children, variant, color, href, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmailButton'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:black|purple|white)$/]",
        "message": "<EmailButton> color must be one of 'black' | 'purple' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmailFooterLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|key|ref|className|style|children)$/]",
        "message": "<EmailFooterLink> doesn't accept that prop. Declared props: label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmailHeroCTA'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|color|key|ref|className|style|children)$/]",
        "message": "<EmailHeroCTA> doesn't accept that prop. Declared props: label, href, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmailHeroCTA'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:black|white)$/]",
        "message": "<EmailHeroCTA> color must be one of 'black' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmailListItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|text|key|ref|className|style|children)$/]",
        "message": "<EmailListItem> doesn't accept that prop. Declared props: title, text."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmailModule'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|align|padding|style|key|ref|className|style|children)$/]",
        "message": "<EmailModule> doesn't accept that prop. Declared props: children, tone, align, padding, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmailModule'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<EmailModule> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|weight|fill|grade|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, weight, fill, grade, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|type|value|onChange|placeholder|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, hint, type, value, onChange, placeholder, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|height|assetBase|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: variant, height, assetBase, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:purple|white)$/]",
        "message": "<Logo> variant must be one of 'purple' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|max|height|tone|style|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: value, max, height, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:purple|cyan|gradient)$/]",
        "message": "<ProgressBar> tone must be one of 'purple' | 'cyan' | 'gradient'."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuoteCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:quote|name|role|tone|gradient|style|key|ref|className|style|children)$/]",
        "message": "<QuoteCard> doesn't accept that prop. Declared props: quote, name, role, tone, gradient, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuoteCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:gradient|brand|dark|surface)$/]",
        "message": "<QuoteCard> tone must be one of 'gradient' | 'brand' | 'dark' | 'surface'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slider'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|min|max|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Slider> doesn't accept that prop. Declared props: value, min, max, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|caption|tone|accent|style|key|ref|className|style|children)$/]",
        "message": "<StatCard> doesn't accept that prop. Declared props: value, label, caption, tone, accent, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:surface|muted|brand|dark)$/]",
        "message": "<StatCard> tone must be one of 'surface' | 'muted' | 'brand' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|key|ref|className|style|children)$/]",
        "message": "<TabItem> doesn't accept that prop. Declared props: id, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wayfinder'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|fill|height|width|pointDepth|radius|align|style|contentStyle|key|ref|className|style|children)$/]",
        "message": "<Wayfinder> doesn't accept that prop. Declared props: children, fill, height, width, pointDepth, radius, align, style, contentStyle."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wayfinder'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<Wayfinder> align must be one of 'left' | 'center'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
